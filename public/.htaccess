# Password-protect the site (login popup) when C:/OSPanel/home/iordachi-family-tree/.htpasswd exists.
# /api and /sanctum are left out: the app sends its own "Authorization: Bearer" token there,
# which would replace the Basic credentials and make every API call fail.
# THE_REQUEST is the original request line, so the check survives the rewrite to index.php.
<If "-f 'C:/OSPanel/home/iordachi-family-tree/.htpasswd' && %{THE_REQUEST} !~ m#^[A-Z]+ /(api|sanctum)/#">
    AuthType Basic
    AuthName "Iordachi Family Tree"
    AuthUserFile "C:/OSPanel/home/iordachi-family-tree/.htpasswd"
    Require valid-user
</If>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Serve the Angular build (public/spa/browser) for everything except the API,
    # when a build is present. Run `npm run build:public` in client/ to create it.
    RewriteCond %{REQUEST_URI} !^/(api|sanctum|storage|up)(/|$)
    RewriteCond %{DOCUMENT_ROOT}/spa/browser%{REQUEST_URI} -f
    RewriteRule ^ spa/browser%{REQUEST_URI} [L]

    RewriteCond %{REQUEST_URI} !^/(api|sanctum|storage|up)(/|$)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/spa/browser/index.html -f
    RewriteRule ^ spa/browser/index.html [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
